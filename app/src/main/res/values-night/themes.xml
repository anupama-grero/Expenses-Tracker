<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Night Mode. -->
    <style name="Theme.ExpensesTracker" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryDark</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryBlue</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Background/Surface colors. -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">#121212</item>
        <item name="colorError">@color/error</item>
    </style>
</resources>
